{
  "name": "afrisend",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "description": "AfriSend — Qatar-to-Africa cross-border remittance app (Expo)",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo-doctor",
    "build:preview": "eas build --profile preview --platform all",
    "build:simulator": "eas build --profile simulator --platform ios",
    "build:production": "eas build --profile production --platform all",
    "submit:android": "eas submit --profile production --platform android",
    "submit:ios": "eas submit --profile production --platform ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "~51.0.38",
    "expo-camera": "~15.0.16",
    "expo-constants": "~16.0.2",
    "expo-device": "~6.0.2",
    "expo-font": "~12.0.10",
    "expo-linear-gradient": "~13.0.2",
    "expo-notifications": "~0.28.19",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "babel-preset-expo": "~11.0.15",
    "eas-cli": "^12.5.1"
  }
}
